# ==============================================================================
# TactileTrail Environment Configuration
# Hacktoberfest DEV Challenge - "Touch Grass" Theme
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI MODEL: Google Gemma
# ------------------------------------------------------------------------------
# Option A: Google AI Studio API Key (Recommended)
# Get a free key at: https://aistudio.google.com/
# TactileTrail uses this to invoke Gemma (gemma-2-9b-it / gemma-2-27b-it)
GEMMA_API_KEY=your_google_ai_studio_api_key_here

# Model name override (optional, defaults to gemma-2-9b-it, fallbacks available)
GEMMA_MODEL_NAME=gemma-2-9b-it

# Option B: Hugging Face Inference API (Alternative)
# Get a token at: https://huggingface.co/settings/tokens
# Used for serverless inference with google/gemma-2-9b-it
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# 2. AUDIO ENGINE: ElevenLabs Text-to-Speech
# ------------------------------------------------------------------------------
# Get your API key at: https://elevenlabs.io/
# When provided, checkpoint micro-quests are rendered into ultra-calming,
# lifelike naturalist audio.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID (Defaults to warm, narrative naturalist voices)
# Examples:
#   JBFqnCBsd6RMkjVDRZzb (George - Warm, seasoned British naturalist)
#   pNInz6obpgDQGcFmaJgB (Adam - Deep, soothing cadence)
#   21m00Tcm4TlvDq8ikWAM (Rachel - Calm, meditative guide)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ------------------------------------------------------------------------------
# 3. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
